"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- OpenHIS-UNLaM
-- Migración: antecedentes clínicos personales y familiares
-- Realizar una copia de seguridad de BD/Salud.db antes de ejecutar.
-- Esta migración es aditiva: no modifica ni elimina tablas existentes.

PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS AntecedentesClinicos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    paciente_id INTEGER NOT NULL,
    tipo TEXT NOT NULL
        CHECK (tipo IN ('PERSONAL', 'FAMILIAR')),
    descripcion TEXT NOT NULL
        CHECK (length(trim(descripcion)) &gt; 0),
    profesional_id INTEGER,
    usuario_registro_id INTEGER NOT NULL,
    fecha_registro TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion TEXT,
    activo INTEGER NOT NULL DEFAULT 1
        CHECK (activo IN (0, 1)),

    FOREIGN KEY (paciente_id)
        REFERENCES Pacientes(id),
    FOREIGN KEY (profesional_id)
        REFERENCES Profesionales(id),
    FOREIGN KEY (usuario_registro_id)
        REFERENCES Usuarios(id)
);

CREATE INDEX IF NOT EXISTS idx_antecedentes_paciente
    ON AntecedentesClinicos (
        paciente_id,
        activo,
        fecha_registro DESC
    );
</sql><current_tab id="0"/></tab_sql></sqlb_project>
